# Altiplano master build container with JDK 25 (altiplano-dev-master-25)
BUILDENV_MODE=container
BUILDENV_CONTAINER=altiplano-dev-master-25
BUILDENV_EXPORT=$HOME/env/profiles/altiplano-master-25
# The jdk25 devcontainer mounts the same data folder as altiplano-dev-master.
BUILDENV_LOCAL_REPO=$HOME/devcontainer-data/altiplano-dev-master/.m2/repository
BUILDENV_JDK=/java/jdk-17
