# Altiplano master build container (altiplano-dev-master)
BUILDENV_MODE=container
BUILDENV_CONTAINER=altiplano-dev-master
# After `buildenv export`: maven/, settings.xml, toolchains.xml (host IntelliJ).
BUILDENV_EXPORT=$HOME/env/profiles/altiplano-dev-master
# Host path of the local repository the container bind-mounts as ~/.m2/repository.
BUILDENV_LOCAL_REPO=$HOME/devcontainer-data/altiplano-dev-master/.m2/repository
# JDK the container's mvn runs with; suggested IDE project SDK.
BUILDENV_JDK=/java/jdk-17
