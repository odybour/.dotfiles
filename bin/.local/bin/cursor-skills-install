#!/usr/bin/env bash
# Symlink cursor/skills and cursor/rules from a git repo into ~/.cursor/skills and ~/.cursor/rules.
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: cursor-skills-install [REPO_ROOT]

Install Cursor skills and rules from a repository that contains:
  cursor/skills/<skill-name>/...
  cursor/rules/*.mdc          (optional)

REPO_ROOT defaults to git toplevel of $PWD, or $PWD if not in a git repo.
Run from dotfiles after ./install, or from any repo (e.g. java-perf-toolkit).
EOF
}

resolve_repo_root() {
	if [[ $# -ge 1 && -n "${1:-}" ]]; then
		echo "$(cd "$1" && pwd)"
		return
	fi
	if git rev-parse --show-toplevel >/dev/null 2>&1; then
		git rev-parse --show-toplevel
		return
	fi
	pwd
}

warn_if_broken() {
	local target="$1"
	local label="$2"
	if [[ -L "$target" ]]; then
		if ! readlink -f "$target" >/dev/null 2>&1; then
			echo "warning: broken $label $target" >&2
		fi
	fi
}

REPO_ROOT="$(resolve_repo_root "${1:-}")"
SKILLS_DIR="$REPO_ROOT/cursor/skills"
RULES_DIR="$REPO_ROOT/cursor/rules"

if [[ ! -d "$SKILLS_DIR" && ! -d "$RULES_DIR" ]]; then
	usage >&2
	echo "error: no cursor/skills or cursor/rules under $REPO_ROOT" >&2
	exit 1
fi

mkdir -p "$HOME/.cursor/skills" "$HOME/.cursor/rules"

if [[ -d "$SKILLS_DIR" ]]; then
	for skill_path in "$SKILLS_DIR"/*; do
		[[ -d "$skill_path" ]] || continue
		skill_name=$(basename "$skill_path")
		dest="$HOME/.cursor/skills/$skill_name"
		echo "Installing skill $skill_name from $REPO_ROOT ..."
		ln -sfn "$skill_path" "$dest"
		warn_if_broken "$dest" "skill"
	done
fi

if [[ -d "$RULES_DIR" ]]; then
	shopt -s nullglob
	for rule_path in "$RULES_DIR"/*.mdc; do
		rule_name=$(basename "$rule_path")
		dest="$HOME/.cursor/rules/$rule_name"
		echo "Installing rule $rule_name from $REPO_ROOT ..."
		ln -sfn "$rule_path" "$dest"
		warn_if_broken "$dest" "rule"
	done
	shopt -u nullglob
fi

echo "Done ($REPO_ROOT)."
