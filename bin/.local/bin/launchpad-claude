#!/usr/bin/env python3
"""Expose Cursor's Launchpad plugins to Claude Code.

Builds a Claude-format view of ~/.cursor/plugins/cache/<marketplace>/<plugin>/<sha>/
under ~/.claude/launchpad/ (a local Claude marketplace):

  <plugin>/.claude-plugin/plugin.json   generated from .cursor-plugin/plugin.json
  <plugin>/<entry>                      copy of every other top-level entry, except
                                        hooks/ (Cursor-only) and rules/ (Claude refuses
                                        symlinks that leave the plugin directory)
  .claude-plugin/marketplace.json       lists all plugins
  ~/.claude/rules/launchpad-<plugin>-<rule>.md
                                        generated from rules/*.mdc (frontmatter stripped)

Hooks are not ported. Re-run after Cursor updates its plugins.

Env: CURSOR_HOME (~/.cursor), CLAUDE_HOME (~/.claude), LAUNCHPAD_CACHE_NAME (kairosaica-launchpad).
"""
import json
import os
import re
import shutil
import sys
from pathlib import Path

CURSOR_HOME = Path(os.environ.get("CURSOR_HOME", Path.home() / ".cursor"))
CLAUDE_HOME = Path(os.environ.get("CLAUDE_HOME", Path.home() / ".claude"))
CACHE = CURSOR_HOME / "plugins" / "cache" / os.environ.get("LAUNCHPAD_CACHE_NAME", "kairosaica-launchpad")
OUT = CLAUDE_HOME / "launchpad"
RULES_OUT = CLAUDE_HOME / "rules"
SKIP = {".cursor-plugin", "hooks", "rules", ".cache-complete", ".git", ".gitignore"}
PREFIX = "launchpad-"


def latest_build(plugin_dir: Path):
    builds = [d for d in plugin_dir.iterdir() if d.is_dir() and (d / ".cursor-plugin" / "plugin.json").is_file()]
    complete = [d for d in builds if (d / ".cache-complete").exists()] or builds
    return max(complete, key=lambda d: d.stat().st_mtime, default=None)


def strip_frontmatter(text: str) -> str:
    m = re.match(r"\A---\n.*?\n---\n", text, re.S)
    return text[m.end():].lstrip("\n") if m else text


def reset_dir(path: Path):
    """Remove a plugin view we generated under ~/.claude/launchpad."""
    assert path.parent == OUT, path
    shutil.rmtree(path)


def main() -> int:
    if not CACHE.is_dir():
        print(f"error: {CACHE} not found (is the Launchpad marketplace installed in Cursor?)", file=sys.stderr)
        return 1

    OUT.mkdir(parents=True, exist_ok=True)
    RULES_OUT.mkdir(parents=True, exist_ok=True)
    for stale in RULES_OUT.glob(f"{PREFIX}*.md"):
        if stale.is_file() and not stale.is_symlink():
            stale.unlink()

    entries = []
    for plugin_dir in sorted(p for p in CACHE.iterdir() if p.is_dir()):
        build = latest_build(plugin_dir)
        if build is None:
            print(f"warning: no usable build under {plugin_dir}", file=sys.stderr)
            continue
        meta = json.loads((build / ".cursor-plugin" / "plugin.json").read_text())
        name = meta["name"]
        target = OUT / name
        if target.is_dir():
            reset_dir(target)
        target.mkdir(parents=True)

        manifest = {k: meta[k] for k in ("name", "version", "description", "author", "keywords") if k in meta}
        (target / ".claude-plugin").mkdir(exist_ok=True)
        (target / ".claude-plugin" / "plugin.json").write_text(json.dumps(manifest, indent=2) + "\n")

        for item in sorted(build.iterdir()):
            if item.name in SKIP:
                continue
            if item.is_dir():
                shutil.copytree(item, target / item.name, symlinks=True)
            else:
                shutil.copy2(item, target / item.name)

        rules = sorted((build / "rules").glob("*.mdc")) if (build / "rules").is_dir() else []
        for rule in rules:
            dest = RULES_OUT / f"{PREFIX}{name}-{rule.stem}.md"
            dest.write_text(
                f"<!-- generated by launchpad-claude from {rule} -->\n\n"
                + strip_frontmatter(rule.read_text())
            )
        print(f"{name} {meta.get('version', '?')}: {build.name[:8]}, {len(rules)} rule(s)")
        entries.append({"name": name, "source": f"./{name}", "description": meta.get("description", "")})

    # remove plugin views whose cache disappeared
    wanted = {e["name"] for e in entries}
    for old in OUT.iterdir():
        if old.is_dir() and old.name != ".claude-plugin" and old.name not in wanted:
            print(f"Removing stale plugin view {old}")
            reset_dir(old)

    (OUT / ".claude-plugin").mkdir(exist_ok=True)
    (OUT / ".claude-plugin" / "marketplace.json").write_text(json.dumps(
        {"name": "launchpad", "owner": {"name": "Nokia"}, "plugins": entries}, indent=2) + "\n")
    print(f"Done: {OUT} (register: claude plugin marketplace add {OUT})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
