#! /usr/bin/env bash
set -e

if [ ! -f "env/.dotfiles.env" ]; then
	cp env/.dotfiles.env.template env/.dotfiles.env
fi

source env/.dotfiles.env

# go to DOTFILES folder
cd $DOTFILES

# Installing all dotfiles
for folder in ${STOW_FOLDERS[@]}; do
	echo Installing $folder...
	#    Use adopt with caution! It will replace target files. Use `stow -nvt ~` to see the changes first.
	#    stow --adopt -vt ~ $folder
	if [ "$folder" = "cursor" ]; then
		# Cursor skills/rules are linked below; cli-config is Cursor-managed mutable state.
		stow --ignore='(skills|rules|cli-config\.json)$' -vt ~ $folder
	else
		stow -vt ~ $folder
	fi
done

# Link Cursor skills directly into ~/.cursor/skills to avoid owning ~/.cursor/skills itself.
if [ -d "cursor/.cursor/skills" ]; then
	mkdir -p "$HOME/.cursor/skills"
	for skill_path in cursor/.cursor/skills/*; do
		if [ -d "$skill_path" ]; then
			skill_name=$(basename "$skill_path")
			echo Installing cursor skill $skill_name...
			ln -sfn "$DOTFILES/$skill_path" "$HOME/.cursor/skills/$skill_name"
		fi
	done
fi

# Link Cursor rules directly into ~/.cursor/rules to avoid owning ~/.cursor/rules itself.
if [ -d "cursor/.cursor/rules" ]; then
	mkdir -p "$HOME/.cursor/rules"
	for rule_file in cursor/.cursor/rules/*.mdc; do
		if [ -f "$rule_file" ]; then
			rule_name=$(basename "$rule_file")
			echo Installing cursor rule $rule_name...
			ln -sfn "$DOTFILES/$rule_file" "$HOME/.cursor/rules/$rule_name"
		fi
	done
fi
echo Done!

# Create system-wide symlinks only if needed
if [ ! -L "/usr/bin/vi" ] || [ "$(readlink /usr/bin/vi)" != "$HOME/.local/bin/vi" ]; then
	echo "Creating symlink: /usr/bin/vi -> ~/.local/bin/vi"
	sudo ln -fs ~/.local/bin/vi /usr/bin/vi
fi

if [ ! -L "/usr/bin/vim" ] || [ "$(readlink /usr/bin/vim)" != "/usr/bin/vi" ]; then
	echo "Creating symlink: /usr/bin/vim -> /usr/bin/vi"
	sudo ln -fs /usr/bin/vi /usr/bin/vim
fi

# come back to the previous working dir
cd -
